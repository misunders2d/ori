# Secrets & Vault
.env
data/vault/

# Databases & Runtime State
data/.env
data/*
data/.*

# Temporary Folders
.pytest_cache/
__pycache__/
*.pyc
tmp/

# Local probe / diagnostic scripts and their outputs (Keepa cache, bulk
# test results) — kept out of source control to avoid leaking ASIN
# data, API token counts, and personal seller info.
scripts/keepa_probe.py
scripts/keepa_bulk_test.py
scripts/keepa_probe_output_*.json
scripts/keepa_probe_raw_*.json
scripts/keepa_bulk_test_output.json

# Environment
.venv/
node_modules/
.DS_Store

# Linked git worktrees live in .worktrees/<name>/ (each is its own checkout
# of a different branch — managed via `git worktree add/move/remove`).
# They MUST be ignored here so the canonical checkout doesn't treat them as
# untracked files and so tools (pytest, ruff, find) don't traverse into
# them. Use `git worktree list` to see all linked worktrees.
.worktrees/
