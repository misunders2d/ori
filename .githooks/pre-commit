#!/usr/bin/env bash
# Pre-commit doc-read gate (Phase 8).
#
# Every commit must be preceded by a fresh `.docs_read_marker` proving
# the committer has opened docs/AI_EDITS.md and docs/INDEX.md. Without
# the marker, this hook blocks the commit and prints how to satisfy it.
#
# Install once per clone:   git config core.hooksPath .githooks
# (also installed automatically by scripts/install_hooks.py + run_bot.py
# startup + deploy/ori-supervisor.py boot sequence).
#
# Override (forbidden by docs/AI_EDITS.md rule 4): `--no-verify`.

set -e

MARKER=".docs_read_marker"
MAX_AGE_SECONDS=7200  # 2 hours — long enough for a focused session, short enough that stale markers expire

if [ ! -f "$MARKER" ]; then
    cat >&2 <<'EOF'

❌  COMMIT BLOCKED — doc-read marker missing.

Every code change in this repo must be preceded by reading:
  - docs/AI_EDITS.md  (the 12 hard rules)
  - docs/INDEX.md     (the auto-generated symbol map — never reinvent)

To satisfy the gate (after actually reading them), run:

    uv run python scripts/check_docs_read.py

That writes `.docs_read_marker`, valid for 2 hours, and lets the commit
through. The marker is in `.gitignore` so it never leaks across clones.

Do NOT bypass with `git commit --no-verify` — it's forbidden by
docs/AI_EDITS.md rule 4. Bypassing leaves no audit trail.

EOF
    exit 1
fi

# Stat the marker: portable mtime via stat -c (GNU) or stat -f (BSD).
if stat -c %Y "$MARKER" >/dev/null 2>&1; then
    MARKER_MTIME=$(stat -c %Y "$MARKER")
else
    MARKER_MTIME=$(stat -f %m "$MARKER")
fi

NOW=$(date +%s)
AGE=$(( NOW - MARKER_MTIME ))

if [ "$AGE" -gt "$MAX_AGE_SECONDS" ]; then
    cat >&2 <<EOF

❌  COMMIT BLOCKED — doc-read marker is stale ($((AGE / 60)) min old, limit ${MAX_AGE_SECONDS} s).

Re-read docs/AI_EDITS.md + docs/INDEX.md if structure has changed,
then refresh the marker:

    uv run python scripts/check_docs_read.py

EOF
    exit 1
fi

# Auto-regenerate the symbol index before committing (Phase 8.1).
# Picks up any new agent/tool/toolset/callback/skill the agent staged.
# Auto-stages whatever changed so the commit ships in lockstep with the
# code. Skipped silently when uv is unavailable (e.g. minimal container).
if command -v uv >/dev/null 2>&1; then
    if uv run python scripts/gen_docs.py >/dev/null 2>&1; then
        # Re-stage whichever of the auto-generated docs gen_docs touched.
        AUTO_DOCS="docs/INDEX.md docs/AGENTS_INVENTORY.md docs/TOOLS.md docs/TOOLSETS.md docs/CALLBACKS.md"
        for f in $AUTO_DOCS; do
            if [ -f "$f" ]; then
                # `git diff --quiet` exits non-zero when the file has changes.
                if ! git diff --quiet -- "$f" 2>/dev/null; then
                    git add -- "$f"
                    echo "ℹ️  pre-commit: regenerated + staged $f" >&2
                fi
            fi
        done
    else
        echo "warning: gen_docs.py failed during pre-commit; INDEX may be stale" >&2
    fi
fi

# Design-doc check: behaviour-relevant code must ship with at least one
# hand-written doc edit in the same commit. Auto-gen covers symbols;
# hand-written docs cover WHY. Caught 2026-05-11 audit (rule 10).
# Bypass for genuinely doc-irrelevant commits: ORI_SKIP_DOC_CHECK=1 git commit ...
if [ "${ORI_SKIP_DOC_CHECK:-0}" != "1" ]; then
    # ``|| true`` keeps the assignment safe when the hook is invoked
    # outside a git repo (test harness copies the hook into a tmp dir).
    STAGED=$(git diff --cached --name-only --diff-filter=ACMRT 2>/dev/null || true)
    BEHAVIOUR_TOUCHED=$(echo "$STAGED" | grep -E '^(app/(callbacks|tools|toolsets|sub_agents|contracts)/|app/app_utils/models\.py$|app/agent\.py$)' || true)
    if [ -n "$BEHAVIOUR_TOUCHED" ]; then
        DOCS_TOUCHED=$(echo "$STAGED" | grep -E '^docs/.*\.md$' || true)
        if [ -z "$DOCS_TOUCHED" ]; then
            cat >&2 <<EOF

❌  COMMIT BLOCKED — behaviour-relevant code staged with no docs/*.md change.

Staged code (one or more):
$(echo "$BEHAVIOUR_TOUCHED" | sed 's/^/    /')

Per docs/AI_EDITS.md §10: every product change ships with the matching
hand-written design doc in the same commit. Auto-gen covers SYMBOLS;
A2A.md / HOT_SWAP.md / EVOLUTION.md / PLANS.md / SCRATCHPAD.md /
CONTRACTS.md / RUNBOOK.md cover the WHY.

To proceed:
  1. Edit the matching doc with the design rationale + gotchas, OR
  2. If the change is genuinely doc-irrelevant (typo / lint / dead-code
     removal), bypass with:
         ORI_SKIP_DOC_CHECK=1 git commit ...

EOF
            exit 1
        fi
    fi
fi

# V2 scheduler phase scope guard (docs/PHASE_1_PLAN.md §6).
# Inert when .v2-current-phase is missing. While active (phase 1..7),
# blocks commits that touch v1 scheduler paths or files outside the
# current phase's allowlist. Logic lives in scripts/check_phase_scope.py;
# wrapper at .githooks/v2_phase_guard.sh. Override semantics (rare,
# emergency-only) are handled by the CI workflow, NOT here — local
# rejection is hard.
if [ -f ".v2-current-phase" ] && command -v uv >/dev/null 2>&1; then
    if ! bash ".githooks/v2_phase_guard.sh"; then
        exit 1
    fi
fi

exit 0
